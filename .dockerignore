# Exclude everything by default, then whitelist what the build needs.
# The only directories COPY'd into the image are sdk2/unitree_sdk2 and
# sdk2/unitree_sdk2_python (see Dockerfile). Everything else is either
# bind-mounted at runtime or not needed at build time.

**

!sdk2/unitree_sdk2/**
!sdk2/unitree_sdk2_python/**

# Re-exclude host build artifacts and VCS metadata so they don't leak into
# the image build context (otherwise stale CMake build dirs from local
# builds break in-image `mkdir build`).
sdk2/unitree_sdk2/build/
sdk2/unitree_sdk2/install/
sdk2/unitree_sdk2_python/build/
sdk2/unitree_sdk2_python/dist/
sdk2/unitree_sdk2_python/**/__pycache__/
sdk2/unitree_sdk2_python/**/*.egg-info/
sdk2/unitree_sdk2/.git
sdk2/unitree_sdk2_python/.git
